# Application
APP_NAME=Adaptive Learning System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501
BACKEND_API_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./data/app.db

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# LLM provider
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Optional embedding model
EMBEDDING_MODEL=

# Knowledge Unit rules
KU_MIN_CONCEPTS=2
KU_MAX_CONCEPTS=7
KU_MAX_LEARNING_OBJECTIVES=3
KU_MIN_READING_MINUTES=2
KU_MAX_READING_MINUTES=10
KU_MAX_REFINEMENT_ROUNDS=2

# Question rules
QUESTION_COUNT_PER_UNIT=3
MAX_MAIN_QUESTIONS_PER_UNIT=3
MAX_REMEDIATION_QUESTIONS=2
QUESTION_GENERATION_CANDIDATES=5

# Mastery
MASTERY_INITIAL_SCORE=0.0
MASTERY_OLD_WEIGHT=0.7
MASTERY_NEW_WEIGHT=0.3
MASTERY_THRESHOLD=0.8
MIN_QUESTIONS_FOR_MASTERY=3
REQUIRE_APPLICATION_FOR_MASTERY=true

# Agent
AGENT_ENABLED=true
AGENT_MAX_STEPS=5
AGENT_TEMPERATURE=0.2
AGENT_TRIGGER_WRONG_COUNT=2
AGENT_TRIGGER_LOW_SCORE=0.4
AGENT_TRIGGER_RECALL_APPLICATION_GAP=0.25
AGENT_TRACE_ENABLED=true
